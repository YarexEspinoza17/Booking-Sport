# === Database (Supabase / Postgres) ===
DATABASE_URL=postgresql://postgres:password@localhost:5432/accrom?schema=public

# === Auth ===
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_strong_secret

# === Redis (locks/holds & rate limiting) ===
REDIS_URL=redis://localhost:6379

# === Tilopay ===
TILOPAY_API_KEY=replace
TILOPAY_WEBHOOK_SECRET=replace

# === Multitenancy (optional domain root to parse subdomains) ===
ROOT_DOMAIN=localhost
