generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Org {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                  String                  @unique
  name                  String
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  court                 Court[]
  court_base_price      court_base_price[]
  court_blackout        court_blackout[]
  court_type            court_type[]
  court_weekly_schedule court_weekly_schedule[]
  customer              customer[]
  employee              employee[]
  org_domain            org_domain[]
  payment               Payment[]
  price_rule            price_rule[]
  reservation           Reservation[]
  reservation_hold      reservation_hold[]
  sites                 Site[]

  @@map("org")
}

model Site {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id           String             @db.Uuid
  name             String
  timezone         String             @default("America/Costa_Rica")
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  courts           Court[]
  employee_site    employee_site[]
  reservation      Reservation[]
  reservation_hold reservation_hold[]
  org              Org                @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([org_id, name], map: "uq_site_org_name")
  @@index([org_id], map: "idx_site_org")
  @@map("site")
}

model Court {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id                String                  @db.Uuid
  site_id               String                  @db.Uuid
  court_type_id         String                  @db.Uuid
  name                  String
  buffer_before_minutes Int                     @default(0)
  buffer_after_minutes  Int                     @default(0)
  active                Boolean                 @default(true)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  court_type            court_type              @relation(fields: [court_type_id], references: [id], onUpdate: NoAction)
  org                   Org                     @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  site                  Site                    @relation(fields: [site_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  court_base_price      court_base_price?
  court_blackout        court_blackout[]
  court_weekly_schedule court_weekly_schedule[]
  price_rule            price_rule[]
  reservation           Reservation[]
  reservation_hold      reservation_hold[]

  @@unique([org_id, site_id, name], map: "uq_court_name")
  @@index([org_id, site_id], map: "idx_court_org_site")
  @@index([court_type_id], map: "idx_court_type")
  @@map("court")
}

model Reservation {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id          String                   @db.Uuid
  site_id         String                   @db.Uuid
  court_id        String                   @db.Uuid
  customer_id     String?                  @db.Uuid
  created_by      String?                  @db.Uuid
  start_time      DateTime                 @db.Timestamptz(6)
  end_time        DateTime                 @db.Timestamptz(6)
  effective_range Unsupported("tstzrange")
  currency        ccy                      @default(CRC)
  price_int       Int
  status          reservation_status       @default(HELD)
  hold_expires_at DateTime?                @db.Timestamptz(6)
  payment_id      String?                  @db.Uuid
  notes           String?
  created_at      DateTime                 @default(now()) @db.Timestamptz(6)
  payment         Payment[]
  court           Court                    @relation(fields: [court_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employee        employee?                @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  customer        customer?                @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  org             Org                      @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  site            Site                     @relation(fields: [site_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([org_id, site_id, court_id, start_time, end_time], map: "idx_reservation_org_site_court")
  @@index([status], map: "idx_reservation_status")
  @@index([court_id, effective_range], map: "idx_reservation_effective", type: Gist)
  @@map("reservation")
}

model Payment {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id         String         @db.Uuid
  reservation_id String         @db.Uuid
  provider       String         @default("tilopay")
  external_id    String         @unique
  status         payment_status @default(INITIATED)
  currency       ccy            @default(CRC)
  amount_int     Int
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  org            Org            @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reservation    Reservation    @relation(fields: [reservation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([org_id], map: "idx_payment_org")
  @@map("payment")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model court_base_price {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id     String   @db.Uuid
  court_id   String   @unique(map: "uq_court_base_price") @db.Uuid
  currency   ccy      @default(CRC)
  amount_int Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  court      Court    @relation(fields: [court_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  org        Org      @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([org_id], map: "idx_cbp_org")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model court_blackout {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id     String   @db.Uuid
  court_id   String   @db.Uuid
  starts_at  DateTime @db.Timestamptz(6)
  ends_at    DateTime @db.Timestamptz(6)
  reason     String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  court      Court    @relation(fields: [court_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  org        Org      @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model court_type {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id     String   @db.Uuid
  code       String
  name       String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  court      Court[]
  org        Org      @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([org_id, code], map: "uq_court_type")
  @@index([org_id], map: "idx_court_type_org")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model court_weekly_schedule {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id      String   @db.Uuid
  court_id    String   @db.Uuid
  dow         Int
  start_local DateTime @db.Time(6)
  end_local   DateTime @db.Time(6)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  court       Court    @relation(fields: [court_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  org         Org      @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([court_id, dow, start_local, end_local], map: "idx_cws_court_dow")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model customer {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id      String        @db.Uuid
  email       String?
  phone       String?
  full_name   String?
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  org         Org           @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reservation Reservation[]

  @@index([org_id], map: "idx_customer_org")
  @@index([org_id, phone], map: "idx_customer_phone")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model employee {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id        String          @db.Uuid
  email         String          @unique
  full_name     String?
  role          user_role       @default(STAFF)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  password_hash String?
  org           Org             @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employee_site employee_site[]
  reservation   Reservation[]

  @@index([org_id], map: "idx_employee_org")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model employee_site {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id String   @db.Uuid
  site_id     String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  employee    employee @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  site        Site     @relation(fields: [site_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([employee_id, site_id], map: "uq_employee_site")
  @@index([site_id], map: "idx_employee_site_site")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model org_domain {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id     String   @db.Uuid
  domain     String   @unique
  created_at DateTime @default(now()) @db.Timestamptz(6)
  org        Org      @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model price_rule {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id      String    @db.Uuid
  court_id    String    @db.Uuid
  dow         Int?
  start_local DateTime? @db.Time(6)
  end_local   DateTime? @db.Time(6)
  multiplier  Decimal?  @db.Decimal(6, 3)
  add_int     Int?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  court       Court     @relation(fields: [court_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  org         Org       @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([court_id, dow, start_local, end_local], map: "idx_price_rule_court")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model reservation_hold {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id     String   @db.Uuid
  site_id    String   @db.Uuid
  court_id   String   @db.Uuid
  start_time DateTime @db.Timestamptz(6)
  end_time   DateTime @db.Timestamptz(6)
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  court      Court    @relation(fields: [court_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  org        Org      @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  site       Site     @relation(fields: [site_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([org_id, site_id, court_id, expires_at], map: "idx_reservation_hold_main")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model webhook_event {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String
  event_type  String
  external_id String
  payload     Json
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([provider, external_id], map: "uq_webhook_event")
}

model app_super_admin {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique
  full_name     String?
  password_hash String
  created_at    DateTime @default(now()) @db.Timestamptz(6)
}

enum ccy {
  CRC
  USD
}

enum payment_status {
  INITIATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIAL_REFUNDED
}

enum reservation_status {
  HELD
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  REFUNDED
  NO_SHOW
}

enum user_role {
  ADMIN
  STAFF
  CUSTOMER
}
